cff-version: 1.2.0
title: "No reproducible accuracy gain from lightweight attention modules in fine-grained classification of 39 toxic Chinese herbal medicines"
message: "If you use this software or the released analysis artefacts, please cite it."
type: software
authors:
  - family-names: Shao
    given-names: Zigang
    orcid: "https://orcid.org/0009-0008-9105-1861"
    affiliation: "The Second Affiliated Hospital of Heilongjiang University of Chinese Medicine"
